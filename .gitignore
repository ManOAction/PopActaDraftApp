# Rules are path-agnostic on purpose. The old file scoped them to `frontend/...`,
# and the 2026-07 relayout silently unignored 30k node_modules files the moment
# that directory moved. Match by name, not by location.

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Databases ---------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# --- Node / Bun --------------------------------------------------------------
node_modules/
dist/
out/
.cache/
.bun/
.eslintcache
*.tsbuildinfo
bun.lockb
*.tgz
coverage/
*.lcov

# --- Build / infra -----------------------------------------------------------
caddy_data/
caddy_config/
certbot/
*.pid
**/Dockerfile~

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
